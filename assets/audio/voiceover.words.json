 "sentences": [
  {
   "i": 0,
   "rate": "+8%",
   "pitch": "+4Hz",
   "volume": "+6%",
   "pause_after": 0.44,
   "text": "Pada 1790, pasukan berbaju besi menabrak kota Romawi di Sungai Narmada, menembus tembok seakan terbuat dari air."
  },
  {
   "i": 1,
   "rate": "+5%",
   "pitch": "+2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Dan yang bikin lo merinding, mereka mengungkap rahasia perang tiga hari yang terlupakan."
  },
  {
   "i": 2,
   "rate": "+2%",
   "pitch": "-2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Sungai Narmada, 6.000 kilometer panjangnya, menjadi medan pertempuran pada 1790, ketika pasukan Persia dan India bersatu menaklukkan Romawi."
  },
  {
   "i": 3,
   "rate": "+2%",
   "pitch": "+2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Pasukan berbaju besi, dengan helm berlapis besi, menembus pertahanan kota dalam waktu 72 jam, menewaskan 12.000 tentara Romawi dan menghancurkan benteng utama."
  },
  {
   "i": 4,
   "rate": "+5%",
   "pitch": "-2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Tapi tunggu, bagian paling gila belum lo dengar."
  },
  {
   "i": 5,
   "rate": "+5%",
   "pitch": "+2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Ternyata, pasukan tersebut memakai senjata api yang terbuat dari batu bara, yang belum diketahui sampai kini."
  },
  {
   "i": 6,
   "rate": "+3%",
   "pitch": "+8Hz",
   "volume": "+0%",
   "pause_after": 0.5,
   "text": "Jadi, apakah pertempuran ini memicu revolusi teknologi di Asia? Lo penasaran?"
  },
  {
   "i": 7,
   "rate": "+0%",
   "pitch": "-2Hz",
   "volume": "+0%",
   "pause_after": 0.0,
   "text": "Jadi, kembali ke fakta gila: pasukan berbaju besi menembus tembok seperti air."
  }
 ],
