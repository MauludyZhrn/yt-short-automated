 "sentences": [
  {
   "i": 0,
   "rate": "+8%",
   "pitch": "+4Hz",
   "volume": "+6%",
   "pause_after": 0.44,
   "text": "Pada 2034, teleskop Hubble menangkap semburat cahaya aneh di Kuiper Belt, seolah‑olah energi raksasa menutupi matahari."
  },
  {
   "i": 1,
   "rate": "+5%",
   "pitch": "+2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Dan yang bikin lo merinding, cahaya itu ternyata menyembunyikan lebih banyak misteri daripada yang terlihat."
  },
  {
   "i": 2,
   "rate": "+5%",
   "pitch": "-2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Kuiper Belt, daerah luar planet Neptunus, berisi ratusan ribu es dan batu."
  },
  {
   "i": 3,
   "rate": "+2%",
   "pitch": "+2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Pada 2034, spektrum cahaya menunjukkan suhu 30 kelvin, tetapi energi yang dipancarkan seakan 10 kali lebih besar dari yang diharapkan."
  },
  {
   "i": 4,
   "rate": "+5%",
   "pitch": "-2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Para ilmuwan memeriksa teori gelombang gravitasi, namun data menunjukkan gelombang gelap—fenomena yang menutup sinar dengan cara yang belum pernah dilihat."
  },
  {
   "i": 5,
   "rate": "+5%",
   "pitch": "+2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Tapi tunggu, bagian paling gila belum lo dengar."
  },
  {
   "i": 6,
   "rate": "+2%",
   "pitch": "-2Hz",
   "volume": "+0%",
   "pause_after": 0.3,
   "text": "Penelitian terbaru mengungkap bahwa energi itu berasal dari partikel eksotik yang berputar 1.000.000 rpm, mengaburkan cahaya biasa."
  },
  {
   "i": 7,
   "rate": "+3%",
   "pitch": "+12Hz",
   "volume": "+0%",
   "pause_after": 0.5,
   "text": "Jadi, apakah lo siap menyelami gelombang gelap ini?"
  },
  {
   "i": 8,
   "rate": "+0%",
   "pitch": "-6Hz",
   "volume": "+0%",
   "pause_after": 0.0,
   "text": "Kalau iya, beri komentar dan tonton ulang bagian pertama untuk memaknai misteri ini."
  }
 ],
