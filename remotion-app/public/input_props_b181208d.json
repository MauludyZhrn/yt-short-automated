      "end": 35.899,
      "words": [
        83,
        85
      ]
    },
    {
      "text": "seolah menolak radiasi.",
      "start": 35.499,
      "end": 37.587,
      "words": [
        86,
        88
      ]
    },
    {
      "text": "Tapi tunggu,",
      "start": 37.187,
      "end": 38.54,
      "words": [
        89,
        90
      ]
    },
    {
      "text": "bagian paling gila belum",
      "start": 38.14,
      "end": 39.29,
      "words": [
        91,
        94
      ]
    },
    {
      "text": "lo dengar.",
      "start": 39.14,
      "end": 40.413,
      "words": [
        95,
        96
      ]
    },
    {
      "text": "Ternyata,",
      "start": 40.013,
      "end": 41.315,
      "words": [
        97,
        97
      ]
    },
    {
      "text": "dalam 3.000 tahun astronomi,",
      "start": 40.915,
      "end": 43.239,
      "words": [
        98,
        101
      ]
    },
    {
      "text": "sebuah peristiwa supernova di",
