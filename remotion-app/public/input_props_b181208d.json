        130,
        133
      ]
    },
    {
      "text": "ini?",
      "start": 54.892,
      "end": 55.704,
      "words": [
        134,
        134
      ]
    },
    {
      "text": "Kembali ke fakta pertama,",
      "start": 55.82,
      "end": 57.742,
      "words": [
