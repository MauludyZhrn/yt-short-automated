      "end": 44.3,
      "words": [
        102,
        105
      ]
    },
    {
      "text": "dekatnya memicu pembentukan partikel",
      "start": 44.15,
      "end": 45.918,
      "words": [
        106,
        109
      ]
    },
    {
      "text": "gelap yang memantulkan cahaya.",
