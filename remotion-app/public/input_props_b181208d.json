  "subtitles": [
    {
      "text": "Nebula ini seolah menutup",
      "start": 0.0,
      "end": 0.981,
      "words": [
        0,
        3
      ]
    },
    {
      "text": "diri seperti cermin hitam,",
      "start": 0.831,
      "end": 2.683,
      "words": [
        4,
        7
      ]
    },
    {
      "text": "menolak cahaya apapun.",
      "start": 2.283,
      "end": 3.866,
      "words": [
        8,
        10
      ]
    },
    {
      "text": "Dan yang bikin lo",
      "start": 3.924,
      "end": 4.649,
      "words": [
        11,
        14
      ]
    },
    {
      "text": "merinding,",
      "start": 4.499,
      "end": 5.708,
      "words": [
        15,
        15
      ]
    },
    {
      "text": "ia menyimpan rahasia yang",
      "start": 5.308,
      "end": 6.53,
      "words": [
        16,
        19
      ]
    },
    {
      "text": "tak terungkap.",
      "start": 6.38,
      "end": 7.706,
      "words": [
        20,
        21
      ]
    },
    {
      "text": "Di tahun 2019,",
      "start": 7.306,
      "end": 9.29,
      "words": [
        22,
        24
      ]
    },
    {
      "text": "teleskop Hubble menangkap gambar",
      "start": 8.89,
      "end": 10.351,
      "words": [
        25,
        28
      ]
    },
    {
      "text": "nebula RCW 108 di",
      "start": 10.201,
      "end": 12.049,
      "words": [
        29,
        32
      ]
    },
    {
      "text": "galaksi NGC 6611,",
      "start": 11.899,
      "end": 14.756,
      "words": [
        33,
        35
      ]
    },
    {
      "text": "yang tampak gelap total.",
      "start": 14.356,
      "end": 16.338,
      "words": [
        36,
        39
      ]
    },
    {
      "text": "Para ilmuwan pun mulai",
      "start": 15.938,
      "end": 16.916,
      "words": [
        40,
        43
      ]
    },
    {
      "text": "bertanya-tanya apakah ini efek",
      "start": 16.766,
      "end": 18.333,
      "words": [
        44,
        47
      ]
    },
    {
      "text": "material yang menahan foton.",
      "start": 18.183,
      "end": 20.359,
      "words": [
        48,
        51
      ]
    },
    {
      "text": "Pertama,",
      "start": 19.959,
      "end": 21.219,
      "words": [
        52,
        52
      ]
    },
    {
      "text": "mereka menemukan bahwa nebula",
      "start": 20.819,
      "end": 22.244,
      "words": [
        53,
        56
      ]
    },
    {
      "text": "menampung 5.000 massa matahari,",
      "start": 22.094,
      "end": 24.418,
      "words": [
        57,
        60
      ]
    },
    {
      "text": "lebih berat dari bintang",
      "start": 24.018,
      "end": 25.173,
      "words": [
        61,
        64
      ]
    },
    {
      "text": "rata-rata.",
      "start": 25.023,
      "end": 26.413,
      "words": [
        65,
        65
      ]
    },
    {
      "text": "Kedua,",
      "start": 26.013,
      "end": 27.208,
      "words": [
        66,
        66
      ]
    },
    {
      "text": "suhu di dalamnya turun",
      "start": 26.808,
      "end": 27.951,
      "words": [
        67,
        70
      ]
    },
    {
      "text": "menjadi -200 derajat Celsius,",
      "start": 27.801,
      "end": 30.199,
      "words": [
        71,
        74
      ]
    },
    {
      "text": "seakan membekukan cahaya.",
      "start": 29.799,
      "end": 31.882,
      "words": [
        75,
        77
      ]
    },
    {
      "text": "Ketiga,",
      "start": 31.482,
      "end": 32.72,
      "words": [
        78,
        78
      ]
    },
    {
      "text": "pencarian spektrum menunjukkan adanya",
