      "words": [
        1,
        1
      ]
    },
    {
      "text": "ada sebuah bintang yang",
      "start": 2.267,
      "end": 3.681,
      "words": [
        1,
        2
      ]
    },
    {
      "text": "berdenyut seperti jantung.",
      "start": 3.531,
      "end": 5.25,
      "words": [
        2,
        2
      ]
    },
    {
      "text": "Bukan kedip biasa,",
      "start": 5.2,
      "end": 6.83,
      "words": [
        3,
        3
      ]
    },
    {
      "text": "tapi getaran yang mengubah",
      "start": 6.43,
      "end": 7.932,
      "words": [
        3,
        4
      ]
    },
    {
      "text": "bentuknya sendiri setiap detik.",
      "start": 7.782,
      "end": 9.831,
      "words": [
        4,
        5
      ]
    },
    {
      "text": "Dan yang bikin lo",
      "start": 9.781,
      "end": 11.469,
      "words": [
        6,
        6
      ]
    },
    {
      "text": "merinding,",
      "start": 11.319,
      "end": 12.2,
      "words": [
        7,
        7
      ]
    },
    {
      "text": "getaran itu menghasilkan nada",
      "start": 11.8,
      "end": 13.392,
      "words": [
        7,
        8
      ]
    },
    {
      "text": "yang bisa kita dengar",
      "start": 13.242,
      "end": 14.973,
      "words": [
        8,
        9
      ]
    },
    {
      "text": "kalau diubah jadi suara.",
      "start": 14.823,
      "end": 16.719,
      "words": [
        9,
        9
      ]
    },
    {
      "text": "Bintang itu bernama ...",
      "start": 16.669,
      "end": 18.608,
      "words": [
        10,
        10
      ]
    },
    {
      "text": "sebuah bintang neutron di",
      "start": 18.558,
      "end": 20.246,
      "words": [
        11,
        11
      ]
    },
    {
      "text": "rasi Cygnus,",
      "start": 20.096,
      "end": 21.201,
      "words": [
        12,
        12
      ]
    },
    {
      "text": "berjarak 4.200 tahun cahaya",
      "start": 20.801,
      "end": 22.631,
      "words": [
        12,
        13
      ]
    },
    {
      "text": "dari Bumi.",
      "start": 22.481,
      "end": 23.573,
      "words": [
        13,
        13
      ]
    },
    {
      "text": "Setiap detik,",
